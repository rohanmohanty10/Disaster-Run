    if p1.Name == "SoulCount" then
        Parent.Enabled = true;
        text.Text = "Souls : " .. p1.Value;
        p1.Changed:Connect(function(p2) -- Line: 11
            -- upvalues: text (ref)
            text.Text = "Souls : " .. p2;
        end);
    end;
end);]]></string>
