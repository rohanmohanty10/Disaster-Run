end;

local function CreateFrameList(p2) -- Line: 51
    -- upvalues: New (copy), Children (copy), ForValues (copy), Value (copy), u1 (ref), UIStroke (copy), UITextSizeConstraint (copy), Fusion (copy)
    return New("Frame")({
