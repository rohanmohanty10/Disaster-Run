    return New("TextBox")({
        TextScaled = true,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        PlaceholderText = "Search",
        FontFace = Font.fromEnum(Enum.Font.Ubuntu),
        TextColor3 = Color3.new(1, 1, 1),
        Size = UDim2.fromScale(1, 1)
