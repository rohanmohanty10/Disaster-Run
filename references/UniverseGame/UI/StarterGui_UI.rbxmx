    local Parent = script.Parent;
    local InventoryButton = p1.FusionComponents.InventoryButton;
    InventoryButton(p1, {
        Name = "Items",
        Image = "rbxassetid://7305775896",
        InventoryType = "ItemInventory",
        Parent = Parent,
        ImageSize = UDim2.new(1, 8, 1, 8)
    });
    InventoryButton(p1, {
