            v6:Play();
            v6.Completed:Wait();
            u4:Add(TweenService:Create(u5.LeftChevron, TweenInfo.new(0.4, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {
                Position = UDim2.fromScale(0.367, 0.077)
