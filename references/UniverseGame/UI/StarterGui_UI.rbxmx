              <string name="Source"><![CDATA[  

 

return {
    Busoshoku = {
        [2] = "The constant usage of haki now allows you to strike your foes with increased strength, this buffs the pre-existing damage statistic!",
        [3] = "The constant usage of your busoshoku haki causes it to harden majorly, this buffs the defense statistic.",
        [4] = "The extensive training you went through starts to create a strong thirst for battle, this buffs the special statistic.",
        [5] = "Your haki is now engulfed in scorching flames dramatically boosting your prowesses, resulting in all the properties of this haki to be majorly buffed!"
    },
    Haoshoku = {
        [2] = "Your willpower intensifies, allowing you to unleash Haoshoku Haki with a longer effect on enemies.",
        [3] = "Your haki strengthens, expanding its range and increasing its effectiveness, allowing you to control larger groups of enemies.",
        [4] = "Your mastery over Haoshoku Haki sharpens, enabling you to immediately immobilize multiple foes with a powerful slowdown effect around you.",
        [5] = "Your haki reaches its peak, dramatically enhancing its power, doubling the hitbox size, and blinding your enemies with overwhelming force."
    },
    Kenbunshoku = {
        [2] = "The vision enhanced by your haki has upgraded, allowing you to see targets from distances & their meter count.",
        [3] = "The usage of your Kenbunshoku Haki now allows you to perceive better.",
        [4] = "The constant usage of your Kenbunshoku Haki now enhances the speed of your existing ability techniques.",
        [5] = "All pre-existing properties have been buffed, making this technique much better."
    }
};]]></string>
