    local v14 = Trove.new();
    v14:Add(u13);
    local Party = u11.Cache.Party;

    if Party and Party._Leader == LocalPlayer then
        u13.Kick.Visible = true;
        u13.Promote.Visible = true;
        v14:Connect(u13.Kick.MouseButton1Click, function() -- Line: 91
