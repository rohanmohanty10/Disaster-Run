        Parent.Text.Label.UIGradient.Color = ColorSequence.new(v3, Color3.new(1, 1, 1));
        Parent.Text.Label.UIStroke.Color = v3;
        Parent.Text.Value.UIGradient.Color = ColorSequence.new(v3, Color3.new(1, 1, 1));
