            <string name="Source"><![CDATA[  

 

return {
    Reputation = {
        Title = "<u>Reputation</u>",
        Pages = { {
                Text = "<font color=\"rgb(255,190,80)\"><b>Reputation</b></font> is a new form of progression used to unlock certain <i><b>items</b></i> and <i><b>regions</b>.</i><br/><u>Advance it by:</u><br/>- Exchanging certain <b><i>items</i></b> for <font color=\"rgb(255,190,80)\"><b>Reputation</b></font><br />- Getting bonus on <i><b>Sample Contracts</b></i><br />- Completing smaller <i><b>missions</b></i> given by NPCs",
                Image = "rbxassetid://91507537078592"
            } }
    },
    Analytics = {
        Title = "<u>Analytics</u>",
        Pages = {
            {
                Text = "This is the <font color=\"rgb(51,255,95)\"><b>Analytics</b></font> sector. <br /><br/>Here you can access several new features: <br/> - <font color=\"rgb(51,255,95)\"><b>Research</b></font> <br/> - <b><font color=\"rgb(51,255,95)\">Sample Exchange</font></b><br/> -<b> Sample Contracts</b><br/><br/>You can also show certain items to the <b>Analytics Overseer</b>, if you have them in your inventory, to gain access to specific locked research.",
                Image = "rbxassetid://135572094549361"
            },
            {
                Text = "<b><font color=\"rgb(51,255,95)\">Research</font></b> is a fundemental system in this progression. It allows you to unlock new crafting recipes to be made in <font color=\"rgb(255,158,33)\"><b>Refining</b></font> as well as <b>upgrades.</b><br/><br/><font color=\"rgb(51,255,95)\"><b>Research projects</b></font> are usually unlocked through a one-time item requirement, but in some cases they can be unlocked through other means, such as showing specific <b>items</b> to the <b>Analytics Overseer</b><br/><br/>In order to unlock <b><font color=\"rgb(51,255,95)\">research projects</font></b> that have an item requirement, you also need to meet the required <font color=\"rgb(255,190,80)\"><b>Reputation</b></font> rank.",
                Image = "rbxassetid://87889710343225",
                Title = "<u>Research</u>"
            },
            {
                Text = "<font color=\"rgb(51,255,95)\"><b>Sample exchange</b></font> simply lets you turn in items for <font color=\"rgb(255,190,80)\"><b>Reputation</b></font>.<br/><br/>You can also ask the <b>Analytics Oversser</b> about <b>Sample Contracts</b>, which are randomly generatead quests based on <b><font color=\"rgb(51,255,95)\">sample exchange</font></b>. Completing them yields additional reputation as well as <font color=\"rgb(243,255,51)\"><b>UCoins</b></font> and XP.",
                Image = "rbxassetid://98960221599698",
                Title = "<u>Sample Exchange</u>"
            }
        }
    },
    Refining = {
        Title = "<u>Refining</u>",
        Pages = { {
                Text = "This is the <b><font color=\"rgb(255,158,33)\">Refining</font></b> sector. <br /><br/>This is where you access the new <b><font color=\"rgb(255,158,33)\">Refining/Fabrication</font></b> menu, allowing you to craft specific new items that you have unlocked through <font color=\"rgb(51,255,95)\"><b>research</b></font>.<br/><br/>Additionally, you can turn in <font color=\"rgb(255,137,33)\"><b>Geodes</b></font> when talking to the <b>Refining Overseer</b>. This will yield you random <font color=\"rgb(255,192,33)\"><b>Legendary items</b></font> from the <b>Chest Pool.</b>",
                Image = "rbxassetid://126394115699186"
            } }
    },
    Gateway = {
        Title = "<u>Gateway</u>",
        Pages = {
            {
                Text = "Welcome to the third and final main sector, the <b><font color=\"rgb(255,36,30)\">Gateway</font>.</b><br /><br/>This sector will act as your access point to the <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font>. Talking to the <b>Gateway Overseer</b> allows you to request activation of the <font color=\"rgb(255,54,47)\"><b>Wormhole Generator</b></font>, enabling you and other players to enter the  <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font>.<br/><br/>It is advised that you leave the chamber when the generator is activating. Unless, you happen to have a <font color=\"rgb(255,108,47)\"><b>Catalyst</b></font> in your inventory and feel adventurous...",
                Image = "rbxassetid://88132279189637"
            },
            {
                Text = "The <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font> is another major location. There, you will find powerful new enemies and resources needed to make the <b>Camellia</b> abilities. It is divided into 3 different regions: The <b><font color=\"rgb(214,132,255)\">Void Plane</font></b>, <b><font color=\"rgb(255,56,154)\">Camellite Valley</font></b> and the <font color=\"rgb(56,255,88)\"><b>Corrupt Sector </b></font>.<br/><br/>This floating island is hostile and <b>unforgiving.</b> <font color=\"rgb(224,29,38)\"><b>Dying here will cause you to lose items you have acquired in your expedition (Tools).</b></font> The items you acquired on the <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font> need to <b>stabilize</b> in order to save in your Backpack, which is done by returning to the Map via the <font color=\"rgb(29,133,224)\"><b>Tether</b></font>.",
                Image = "rbxassetid://119346450165445",
                Title = "<u>Fractured Island</u>"
            },
            {
                Text = "<font color=\"rgb(29,133,224)\"><b>Tether</b></font> and <b><font color=\"rgb(224,191,29)\">Radiation</font></b> are new mechanics you will need to manage to survive on the <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font>.<br/><br/>Being suspended above the atmosphere <i>(and home to other mysterious <font color=\"rgb(51,255,95)\"><b>sources</b></font>)</i>, the  <font color=\"rgb(192,73,255)\"><b>Fractured Island</b></font> is exposed to dangerous levels of <b><font color=\"rgb(224,191,29)\">Radiation</font></b>. It is indicated by a meter that fills up over time. When full, you will start taking damage rapidly until you leave or die.<br/><br/>The <font color=\"rgb(29,133,224)\"><b>Tether</b></font>, being a special piece of equipment you are outfitted with from the Lab, uses the radiation exposure to charge itself, enabling you to warp back to the Map before the  <font color=\"rgb(224,191,29)\"><b>Radiation</b></font> fills up. Upon returning, all your items acquired on the island become  <b>stabilized</b> and save upon respawning.",
                Image = "rbxassetid://88117640768623",
                Title = "<u>Tether and Radiation</u>"
            },
            {
                Text = "<b><font color=\"rgb(255,101,202)\">Mining</font></b> is a minigame played to harvest <font color=\"rgb(255,101,202)\"><b>Camellite</b></font> from <font color=\"rgb(255,101,202)\"><b>Camellite Deposits</b></font>. Timing your inputs is important, as your <b>performance dictates your rewards</b>.<br/><br/> When hitting all <b><font color=\"rgb(255,213,101)\">Golden</font></b> zones , you have a chance to also acquire a <b><font color=\"rgb(255,86,47)\">Geode</font></b><font color=\"rgb(255,86,47)\">,</font> which can be exchanged for Reputation or Items at the lab.<br/><br/> Rarely you will also see a special <font color=\"rgb(255,86,47)\"><b>Orange</b></font> zone, guaranteeing a <font color=\"rgb(255,86,47)\"><b>Geode</b></font> to drop if the rest of the zones are hit.",
                Image = "rbxassetid://104236371622291",
                Title = "<u>Mining</u>"
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
