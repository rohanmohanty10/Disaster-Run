        local v21 = u19:GetPinnedQuestName();
        print("UGOCLOSE: CURRENT = ", v21);
        local v22 = p20 == v21;
        print("UGOCLOSE: PIN MATCH", v22);

        if v22 then
            u19:HidePinnedQuestOverlay();
            task.delay(0.35, function() -- Line: 99
                -- upvalues: u19 (copy)
                u19:QuestUI_AutoUpdatePinnedQuest();
            end);
