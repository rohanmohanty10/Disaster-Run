local function CreateRainbowSequence(p1, p2, p3, p4) -- Line: 1
    local v5 = {};

    for i = 1, p1 do
        local v6 = (i - 1) / (p1 - 1);
        table.insert(v5, ColorSequenceKeypoint.new(v6, Color3.fromHSV((v6 - p2) % 1, p3 or 1, p4 or 1)));
    end;

    return ColorSequence.new(v5);
end;

return function(p7) -- Line: 11
