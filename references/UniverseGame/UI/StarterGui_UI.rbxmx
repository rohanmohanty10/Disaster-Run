                Size = UDim2.fromScale(0.162, 0.065)
            }));
            v9:Play();
            v9.Completed:Wait();
            u4:Add(TweenService:Create(u5.RegionBanner.MiddleSplitter, TweenInfo.new(0.45, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {
                Size = Size
