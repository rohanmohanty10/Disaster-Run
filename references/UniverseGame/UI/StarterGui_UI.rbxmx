        u4 = u5:GetAttributeChangedSignal("NocturnusExhaustion"):Connect(function() -- Line: 35
            -- upvalues: u6 (ref), u5 (copy), Parent (ref)
            u6 = u5:GetAttribute("NocturnusExhaustion") or 0;
