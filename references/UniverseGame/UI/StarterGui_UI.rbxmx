    end;

    local _ = p10.NextRank % 2 == 0;

    if p10.NextRank % 5 == 0 then
        local v21 = p9.Benefits:FindFirstChild("KillEffect") or p9.BenefitEntry:Clone();
        v21.NameLabel.Text = "Random Kill Effect";
        v21.AmountLabel.Text = "x1";
