            Text = "Already banned",
            Color = Color3.new(0, 1, 0)
        },
        Picking = {
            Text = "Waiting for pick",
            Color = Color3.new(1, 0, 0)
        },
        Picked = {
            Text = "Already picked",
            Color = Color3.new(0, 1, 0)
        }
    };

    local function AddFrame(p5) -- Line: 31
