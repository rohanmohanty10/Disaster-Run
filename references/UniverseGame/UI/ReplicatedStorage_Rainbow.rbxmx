    for i = 1, p12 do
        local v17 = (i - 1) / (p12 - 1);
        table.insert(v16, ColorSequenceKeypoint.new(v17, Color3.fromHSV((v17 - p13) % 1, p14 or 1, p15 or 1)));
    end;

    return ColorSequence.new(v16);
end;

