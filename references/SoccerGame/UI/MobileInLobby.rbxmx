					<Item class="LocalScript" referent="28643">
						<Properties>
							<ProtectedString name="Source"><![CDATA[ 
 

local UserInputService = game:GetService("UserInputService");
local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui");

local function isMobile() -- Line: 10
    -- upvalues: UserInputService (copy)
    return UserInputService.TouchEnabled;
end;

PlayerGui:WaitForChild("InGameUI");
local Spectate = PlayerGui:WaitForChild("Spectate");
local PickTeam = PlayerGui:WaitForChild("PickTeam");
local GameValues = game:GetService("ReplicatedStorage"):WaitForChild("GameValues");
local script_Parent = script.Parent;

while true do
    while true do
        task.wait(0.1);

        if not UserInputService.TouchEnabled then
            break;
        end;

        local v1;

        if GameValues.State.Value == "Lobby" then
            v1 = not Spectate.Enabled and not PickTeam.Enabled;
        else
            v1 = false;
        end;

        script_Parent.Enabled = script.Parent:GetAttribute("ForceEnable") and true or v1;
    end;

    script_Parent.Enabled = false;
end;]]></ProtectedString>
