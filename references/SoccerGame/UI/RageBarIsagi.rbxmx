					<Item class="LocalScript" referent="27708">
						<Properties>
							<ProtectedString name="Source"><![CDATA[ 
 

local ReplicatedStorage = game:GetService("ReplicatedStorage");
game:GetService("UserInputService");
local Players = game:GetService("Players");
game:GetService("RunService");
game:GetService("Debris");
local TweenService = game:GetService("TweenService");
game:GetService("ReplicatedStorage");
local LocalPlayer = Players.LocalPlayer;
LocalPlayer:WaitForChild("PlayerGui");
local u1 = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait();
u1:WaitForChild("Humanoid");
u1:WaitForChild("HumanoidRootPart");
require(ReplicatedStorage.Packages.Knit);
require(ReplicatedStorage.Shared.Essentials);
require(ReplicatedStorage.Shared.Tweens);
require(ReplicatedStorage.Shared.Trove);
require(ReplicatedStorage.Shared.SoundManager);
require(ReplicatedStorage.Shared.Popup);
UDim2.fromScale(0.5, 0.5);
UDim2.fromScale(0.5, 0.973);
local TweenInfo_new_ret = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
local script_Parent = script.Parent;
local RageBarIsagi = script_Parent:WaitForChild("RageBarIsagi");
local Bar = RageBarIsagi:WaitForChild("ProgressBar"):WaitForChild("Bar");
local Text = RageBarIsagi:WaitForChild("Text");

local function lerp(p2: number, p3: number, p4: number) -- Line: 39
    return p2 + (p3 - p2) * p4;
end;

local function setBar(p5: number) -- Line: 43
    -- upvalues: TweenService (copy), Bar (copy), TweenInfo_new_ret (copy), Text (copy)
    local math_clamp_ret = math.clamp(p5, 0, 1);
    TweenService:Create(Bar, TweenInfo_new_ret, {
        Size = UDim2.fromScale(0.707, math_clamp_ret * 0.946 + 0),
        Position = UDim2.fromScale(0.5, math_clamp_ret * -0.473 + 0.973)
    }):Play();
    Text.Text = `{math.round(math_clamp_ret * 100)}%`;
end;

local PlayerStats = LocalPlayer:WaitForChild("PlayerStats");
local Style = PlayerStats:WaitForChild("Style");
local InAwakening = PlayerStats:WaitForChild("InAwakening");

if Style.Value == "NEL Isagi" then
    script_Parent.Enabled = true;
end;

Style.Changed:Connect(function() -- Line: 65
    -- upvalues: LocalPlayer (copy), script_Parent (copy)
    if LocalPlayer.PlayerStats.Style.Value == "NEL Isagi" and LocalPlayer.Team ~= game:GetService("Teams").Visitor then
        script_Parent.Enabled = true;

        return;
    end;

    script_Parent.Enabled = false;
end);

local function setVisibility() -- Line: 74
    -- upvalues: LocalPlayer (copy), script_Parent (copy)
    if LocalPlayer.Team == game:GetService("Teams").Visitor then
        script_Parent.Enabled = false;
    elseif LocalPlayer.PlayerStats.Style.Value == "NEL Isagi" then
        script_Parent.Enabled = true;
    end;

    if LocalPlayer.PlayerStats.InAwakening.Value == true then
        script_Parent.Enabled = false;
    end;
end;

if LocalPlayer.Team == game:GetService("Teams").Visitor then
    script_Parent.Enabled = false;
elseif LocalPlayer.PlayerStats.Style.Value == "NEL Isagi" then
    script_Parent.Enabled = true;
end;

if LocalPlayer.PlayerStats.InAwakening.Value == true then
    script_Parent.Enabled = false;
end;

LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function() -- Line: 90
    -- upvalues: LocalPlayer (copy), script_Parent (copy)
    if LocalPlayer.Team == game:GetService("Teams").Visitor then
        script_Parent.Enabled = false;
    elseif LocalPlayer.PlayerStats.Style.Value == "NEL Isagi" then
        script_Parent.Enabled = true;
    end;

    if LocalPlayer.PlayerStats.InAwakening.Value == true then
        script_Parent.Enabled = false;
    end;
end);
InAwakening.Changed:Connect(function() -- Line: 95
    -- upvalues: LocalPlayer (copy), script_Parent (copy)
    if LocalPlayer.Team == game:GetService("Teams").Visitor then
        script_Parent.Enabled = false;
    elseif LocalPlayer.PlayerStats.Style.Value == "NEL Isagi" then
        script_Parent.Enabled = true;
    end;

    if LocalPlayer.PlayerStats.InAwakening.Value == true then
        script_Parent.Enabled = false;
    end;
end);

repeat
    task.wait(0.1);
until u1:GetAttribute("RageBar");

u1:GetAttributeChangedSignal("RageBar"):Connect(function() -- Line: 101
    -- upvalues: LocalPlayer (copy), setBar (copy), u1 (copy)
    if LocalPlayer.PlayerStats.Style.Value ~= "NEL Isagi" then
        return;
    end;

    setBar(u1:GetAttribute("RageBar"));
end);]]></ProtectedString>
