						<Properties>
							<ProtectedString name="Source"><![CDATA[ 
 

if not script:FindFirstAncestorOfClass("Player") then
    return;
end;

local ReplicatedStorage = game:GetService("ReplicatedStorage");
local GuiService = game:GetService("GuiService");
local Players = game:GetService("Players");
local RelicsPlayer = require(ReplicatedStorage.RelicsXYZ.RelicsPlayer);
assert(Players.LocalPlayer);
local script_Parent = script.Parent;
local TopBar = script_Parent.TopBar;
local Toggle = TopBar.Toggle;
local u1 = RelicsPlayer.new(script_Parent);
u1:SetEnabled(true);
GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function() -- Line: 33, Name: updateSize
    -- upvalues: GuiService (copy), TopBar (copy)
    local TopbarInset = GuiService.TopbarInset;
    local Min = TopbarInset.Min;
    TopBar.Position = UDim2.fromOffset(Min.X, Min.Y);
    TopBar.Size = UDim2.fromOffset(TopbarInset.Width, TopbarInset.Height);
end);
u1.HasBoomboxChanged:Connect(function() -- Line: 23, Name: checkToggleVisibility
    -- upvalues: u1 (copy), Toggle (copy)
    local v2 = u1:UserHasBoombox();
    Toggle.Visible = v2;

    if v2 then
        u1:SetWindowState("Full");
    end;
end);
Toggle.Activated:Connect(function() -- Line: 41, Name: onActivated
    -- upvalues: u1 (copy)
    if u1:GetWindowState() == "Hidden" then
        u1:SetWindowState("Full");

        return;
    end;

    u1:SetWindowState("Hidden");
end);
local v3 = u1:UserHasBoombox();
Toggle.Visible = v3;

if v3 then
    u1:SetWindowState("Full");
end;

local TopbarInset = GuiService.TopbarInset;
local Min = TopbarInset.Min;
TopBar.Position = UDim2.fromOffset(Min.X, Min.Y);
TopBar.Size = UDim2.fromOffset(TopbarInset.Width, TopbarInset.Height);]]></ProtectedString>
