									<Item class="LocalScript" referent="27421">
										<Properties>
											<ProtectedString name="Source"><![CDATA[ 
 

local ReplicatedStorage = game:GetService("ReplicatedStorage");
local Emote = script.Parent:WaitForChild("RewardIcon"):WaitForChild("WorldModel"):WaitForChild("Emote");
local v1 = ReplicatedStorage.Assets.Misc.BongoModel:Clone();
v1.Parent = Emote;
(function(p2: userdata, p3: userdata) -- Line: 4, Name: motor6dTransfer
    for _, descendant in p2:GetDescendants() do
        if descendant:IsA("Motor") and p3:FindFirstChild(descendant.Name) then
            if descendant.Part0 then
                descendant.Part1 = p3[descendant.Name];
            else
                descendant.Part0 = p3[descendant.Name];
            end;
        end;
    end;
end)(v1, Emote);
local v4 = Emote.Humanoid:LoadAnimation(ReplicatedStorage.Assets.Emotes.Bongo);
v4.Priority = Enum.AnimationPriority.Action4;
v4.Looped = true;
v4:Play();]]></ProtectedString>
