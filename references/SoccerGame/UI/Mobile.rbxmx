					<Item class="LocalScript" referent="24850">
						<Properties>
							<ProtectedString name="Source"><![CDATA[ 
 

local UserInputService = game:GetService("UserInputService");
local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui");
UserInputService:GetLastInputType();

local function isMobile() -- Line: 12
    -- upvalues: UserInputService (copy)
    return UserInputService.TouchEnabled;
end;

local InGameUI = PlayerGui:WaitForChild("InGameUI");
local script_Parent = script.Parent;

while true do
    while true do
        task.wait(0.1);

        if not UserInputService.TouchEnabled then
            break;
        end;

        script_Parent.Enabled = script.Parent:GetAttribute("ForceEnable") and true or InGameUI.Enabled;
    end;

    script_Parent.Enabled = false;
end;]]></ProtectedString>
