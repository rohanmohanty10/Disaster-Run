            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.795",
    Date = 1761321600,
    Notes = {
        {
            Text = "NEW Stand Rehaul",
            Indent = {
                {
                    Text = "- Six Pistols’ abilities and skill tree have been redesigned and rebalanced!"
                }
            }
        },
        {
            Text = "Bug Fixes/QOL",
            Indent = {
                {
                    Text = "- Fixed Road Sign Slam missed/blocked end lag occurring even when successful."
                },
                {
                    Text = "- Fixed Sheer Heart Attack requiring Explosive Power V instead of IV."
                },
                {
                    Text = "- Smoke Grenade no longer gets stuck on the user’s hand when canceled."
                },
                {
                    Text = "- Removed glitchy Thanos and Goku Black skin VFX."
                },
                {
                    Text = "- Neco Arc\'s chin has been remodeled."
                },
                {
                    Text = "- Anubis\' Kikoku skin has been remodeled."
                }
            }
        },
        {
            Text = "Balance Changes & Developer Note",
            Indent = {
                {
                    Text = "- The following stands received changes this update: Beach Boy, King Crimson/King Crimson Requiem, Stone Free, Made in Heaven, Tusk ACTs 1-4, D4C/D4C Love Train, Scary Monsters, The World Alternate Universe, and Soft & Wet: Go Beyond!"
                },
                {
                    Text = "- Join our communications server to see full details on balances from this game version. .gg/sg"
                },
                {
                    Text = "- This update marks the second week of the 2025 Halloween Event and I hope you are all enjoying it so far! We are working very hard on the V1.8 Update and there are many more weekly updates to come!"
                }
            }
        }
    }
};]]></string>
