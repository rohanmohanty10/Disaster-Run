                    Text = "- Increased Crazy Wall cooldown."
                },
                {
                    Text = "- Haymaker hitbox size reduced."
                },
                {
                    Text = "- Tornado Overdrive no longer Stand Crash."
                },
                {
                    Text = "- Tornado Overdrive damage increased."
                },
                {
                    Text = "- Space Ripper Stingy Eyes cooldown slightly reduced."
                },
                {
