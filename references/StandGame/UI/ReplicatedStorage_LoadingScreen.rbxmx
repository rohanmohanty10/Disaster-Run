            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7953",
    Date = 1762621200,
    Notes = {
        {
            Text = "2 NEW Stand Rehauls",
            Indent = {
                {
                    Text = "- Rebalanced Gold Experience & Gold Experience Requiem and their skill trees!"
                },
                {
                    Text = "- New SFX, voicelines, Awakening Themes, and more!"
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Fixed Erasure Pull’s hitbox moving dramatically based on movement."
                },
                {
                    Text = "- Fixed Erasure Acceleration flinging the user backwards."
                },
                {
                    Text = "- Fixed Electric Flash stunning ragdolled opponents."
                },
                {
                    Text = "- Summon Life Form’s bird no longer disappears when used. (Renamed to Life Creation this update)"
                },
                {
                    Text = "- Fixed Summon Tree soft locking users when ragdolled or used in the air."
                },
                {
                    Text = "- Fixed a clipping issue with The World Under Hell skin model."
                }
            }
        },
        {
            Text = "Balance Changes & Dev Note",
            Indent = {
                {
                    Text = "- The following stands received changes this update: Magician\'s Red, The World, TW Over Heaven, Crazy Diamond, The Hand, Red Hot Chili Pepper, and more!"
                },
                {
                    Text = "- Join our communications server to see many more details on balance changes from this game version! /sg"
                },
                {
                    Text = "- Reminder to use the code \"HALLOWEEN2025\" before it expires on December 1st!"
                }
            }
        }
    }
};]]></string>
