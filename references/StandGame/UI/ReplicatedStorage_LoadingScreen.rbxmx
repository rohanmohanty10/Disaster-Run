            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7957",
    Date = 1766120400,
    Notes = {
        {
            Text = "Changes & Bug Fixes",
            Indent = {
                {
                    Text = "2 NEW Stand Skins",
                    Indent = {
                        {
                            Text = "> Mr. Pekin | Legendary (Mr. President)"
                        },
                        {
                            Text = "> Joe\'s Pride | Legendary (Anubis)"
                        }
                    }
                },
                {
                    Text = "- Christmas Lighting Depth of Field adjusted."
                },
                {
                    Text = "- Added barrage trails to Astral Enigma, Wendigo, & Golden Retribution Stand Skins."
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Million Pricks no longer stores its slash effect in unaggroed mobs."
                },
                {
                    Text = "- Fixed an error with Void Surprise\'s targeting."
                },
                {
                    Text = "- Dark Space & Madness Sorrow no longer break in stopped time."
                },
                {
                    Text = "- Turtle Form no longer makes the user\'s stand invisible when it ends."
                },
                {
                    Text = "- Summon Tree walkspeed reduction functions properly now and only upon successfully damaging opponents."
                },
                {
                    Text = "- Santa Kakyoin cosmetic obtainment fixed."
                }
            }
        },
        {
            Text = "Balance Changes",
            Indent = {
                {
                    Text = "- Major balances to Cream & Silver Chariot!"
                },
                {
                    Text = "- Made many changes to Crazy Diamond, Gold Experience, Mr. President, and Hamon (Joseph Joestar)!"
                },
                {
                    Text = "- Join our communications server to see in-depth changes from this game version! /sg"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
