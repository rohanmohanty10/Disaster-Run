        <Item class="ModuleScript" referent="512">
          <Properties>
            <string name="Name">1.7955</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7955",
    Date = 1765040400,
    Notes = {
        {
            Text = "🎄 2025 Christmas Event 🎁",
            Indent = {
                {
                    Text = "- Event will last until January 9th!"
                },
                {
                    Text = "- Christmas Decor added to Main Game!"
                },
                {
                    Text = "- 2x Item Spawns (Stacks with Weekend rates, up to 4x!)"
                },
                {
                    Text = "- 2x Stand Skin Chances"
                },
                {
                    Text = "- Stand Skins limited to previous Christmas events are obtainable again!"
                },
                {
                    Text = "- Christmas Presents spawn in Main Game with a 0.6% chance"
                },
                {
                    Text = "- Christmas Presents also have a chance to be obtained by winning in gamemodes;"
                },
                {
                    Text = "1v1s = 4%"
                },
                {
                    Text = "2v2s = 3%"
                },
                {
                    Text = "Casual SBR 3rd Place = 10%"
                },
                {
                    Text = "Casual SBR 2nd Place = 15%"
                },
                {
                    Text = "Casual SBR 1st Place = 20%"
                },
                {
                    Text = "Competitive SBR 3rd Place = 15%"
                },
                {
                    Text = "Competitive SBR 2nd Place = 20%"
                },
                {
                    Text = "Competitive SBR 1st Place = 25%"
                },
                {
                    Text = "- Paragon is giving out Hot Chocolate for free! Make sure to visit the Cafe while supplies last!"
                }
            }
        },
        {
            Text = "Stand Rework - Cream",
            Indent = {
                {
                    Text = "> New abilities, VFX, and animations!"
                },
                {
                    Text = "> Exploit vulnerabilities patched!"
                }
            }
        },
        {
            Text = "2 New Codes - CHRISTMAS2025 & PARAGONLUCK",
            Indent = {
                {
                    Text = "(Requires Prestige 3 & Expire on New Years Day)"
                }
            }
        },
        {
            Text = "9 New Stand Skins!",
            Indent = {
                {
                    Text = "> Wendigo | Tusk ACT 4 - Legendary [Christmas Limited]"
                },
                {
                    Text = "> Astral Enigma | Gold Experience Requiem - Legendary"
                },
                {
                    Text = "> The Gifter | The Hand - Epic [Christmas Limited]"
                },
                {
                    Text = "> Merry & Sweet | Soft & Wet - Epic [Christmas Limited]"
                },
                {
                    Text = "> Polar President | Mr. President - Epic [Christmas Limited]"
                },
                {
                    Text = "> Spearmint Chariot | Silver Chariot - Epic [Christmas Limited]"
                },
                {
                    Text = "> The Nutcracker | Sticky Fingers - Epic [Christmas Limited]"
                },
                {
                    Text = "> Holiday Tangle | Hermit Purple - Epic [Christmas Limited]"
                },
                {
                    Text = "> Golden Retribution | Tusk ACT 4 - Uncommon"
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Main Game Map received a few changes, making it easier to navigate in some areas."
                },
                {
                    Text = "- Reset all skill trees."
                },
                {
                    Text = "- Join our communications server to see the rest of the balance changes from this game version! /sg"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
