              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.59",
    Date = 1730376000,
    Notes = {
        {
            Text = "2024 Halloween Event",
            Indent = {
                {
                    Text = "- 🎃 Jack, The Cauldron Specter is back with a new personality! 🎃"
                },
                {
                    Text = "- Main game map changed to a Halloween theme"
                },
                {
                    Text = "- 2021 and 2022 Limited Stand and Item Skins re-obtainable!"
                },
                {
                    Text = "- Candy will spawn in the main game map as well!"
                },
                {
                    Text = "- 2x Stand Skin Chances enabled!"
                },
                {
                    Text = "- The event will end when the v1.6 update releases"
                }
            }
        },
        {
            Text = "NEW Shop System",
            Indent = {
                {
                    Text = "- Maximum Money amount increased from $100,000 to $1,000,000"
                },
                {
                    Text = "- When opening the Shop in your Main Menu, you will be able to purchase items using your Money"
                },
                {
                    Text = "- Money can now be bought with ROBUX"
                },
                {
                    Text = "- New premium currency, “Gems”"
                },
                {
                    Text = "- Gems can be used to buy Stand Skin Chests in the new Shop, which rotates hourly"
                },
                {
                    Text = "- Lowered prices of Spec and Stand storage to 499 robux"
                },
                {
                    Text = "- Lowered price of rolling a random stand to 10 robux"
                },
                {
                    Text = "- Lowered price of rolling a random stand skin to 100 robux"
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Stand chances when using Mysterious Arrows changed"
                },
                {
                    Text = "- Reset skill trees"
                },
                {
                    Text = "- Rib Cage of the Saint’s Corpse maximum inventory amount increased to 20. "
                },
                {
                    Text = "- Reduced lag on Killer Queen’s abilities"
                },
                {
                    Text = "- Reduced lag on Time Acceleration and Gravitational Negation abilities"
                },
                {
                    Text = "- Re-added Awakening & Combat Precision music"
                },
                {
                    Text = "- Re-added Red Hot Chili Peppers’ guitar music"
                },
                {
                    Text = "- New Ora Beatdown music and SFX"
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Kicking people from their gangs even if they aren’t a member of your own"
                },
                {
                    Text = "- Joestar Resolve III not working and II having its effects instead"
                },
                {
                    Text = "- Zipper Pole flinging victims"
                },
                {
                    Text = "- Immortality when intentionally holding X on Zipper Flank"
                },
                {
                    Text = "- Arrivederci Beatdown bugging victims when the user resets"
                },
                {
                    Text = "- Mobile users not being able to equip finishers"
                },
                {
                    Text = "- Killer Queen Detonate finisher bugging FOV when used"
                },
                {
                    Text = "- The Hand’s Erasure VFX not appearing"
                },
                {
                    Text = "- Muscle Memory not increasing Haymaker’s damage"
                }
            }
        },
        {
            Text = "Balances",
            Indent = {
                {
                    Text = "- Rebalanced everything…"
                },
                {
                    Text = "- All Stands have had their basic damage and combat speeds adjusted to be similar",
                    Indent = {
                        {
                            Text = "> Example: The Hand can now keep up with The World when engaging in M1 trades, however The World has a slight damage and speed advantage"
                        }
                    }
                },
                {
                    Text = "- Time Stop damage cap lowered from 50% to 40%"
                },
                {
                    Text = "- When taking damage during stopped time, you will be ragdolled and knocked back"
                },
                {
                    Text = "- Stand Barrages in stopped time have their durations extended by 1.5s"
                },
                {
                    Text = "- All Beatdown abilities have had their damage scaling and hitbox durations reduced"
                },
                {
                    Text = "- Adjusted Character Skill Tree point costs slightly"
                },
                {
                    Text = "- Reduced all Fighting Style Skill Tree point costs significantly"
                },
                {
                    Text = "- Reduced effectiveness of most Fighting Style defense/HP boost/HP regen upgrades"
                },
                {
                    Text = "- Rebalanced most Stand skill trees"
                },
                {
                    Text = "- Rebalanced every Fighting Style to be around the same strength"
                },
                {
                    Text = "- Rebalanced most Stands to be around the same strength"
                },
                {
                    Text = "- The following stands have had their movesets and skill trees rehauled:",
                    Indent = {
                        {
                            Text = "> Magician’s Red"
                        },
                        {
                            Text = "> The World Over Heaven"
                        },
                        {
                            Text = "> Crazy Diamond"
                        },
                        {
                            Text = "> The Hand"
                        },
                        {
                            Text = "> Star Platinum: The World"
                        },
                        {
                            Text = "> Killer Queen"
                        },
                        {
                            Text = "> Killer Queen: Bites The Dust"
                        },
                        {
                            Text = "> Sticky Fingers"
                        },
                        {
                            Text = "> Stone Free"
                        },
                        {
                            Text = "> C-Moon"
                        },
                        {
                            Text = "> D4C"
                        },
                        {
                            Text = "> D4C Love Train"
                        },
                        {
                            Text = "> Soft & Wet"
                        },
                        {
                            Text = "> Soft & Wet: Go Beyond"
                        }
                    }
                },
                {
                    Text = "- The following stands have had their movesets notably rebalanced:",
                    Indent = {
                        {
                            Text = "> Made in Heaven"
                        },
                        {
                            Text = "> Tusk ACTS 1-4"
                        },
                        {
                            Text = "> King Crimson Requiem"
                        },
                        {
                            Text = "> Anubis"
                        }
                    }
                },
                {
                    Text = "- AND MORE BALANCES…which are too many to list!"
                },
                {
                    Text = "Try everything out and experiment to see what you like now!"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="526">
          <Properties>
            <string name="Name">1.58</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
