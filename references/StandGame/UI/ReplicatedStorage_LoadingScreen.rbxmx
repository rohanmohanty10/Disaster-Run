        <Item class="ModuleScript" referent="510">
          <Properties>
            <string name="Name">1.796</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.796",
    Date = 1768064400,
    Notes = {
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Christmas 2025 Event has ended.",
                    Indent = {
                        {
                            Text = "> Removed Christmas Decor from Main Game."
                        },
                        {
                            Text = "> Item Spawn rates returned to normal."
                        },
                        {
                            Text = "> Stand Skin chances returned to normal."
                        },
                        {
                            Text = "> Christmas Presents no longer obtainable in Main Game or from winning gamemodes."
                        },
                        {
                            Text = "> Christmas Limited Stand Skins are no longer obtainable."
                        }
                    }
                },
                {
                    Text = "- Added a few new additions to Main Game\'s map."
                },
                {
                    Text = "- Added a stand aura for the Shed Armor ability."
                },
                {
                    Text = "- Added a user aura to the Joe\'s Pride skin."
                },
                {
                    Text = "- Optimized Chariot Requiem & Ghost Chariot Requiem models."
                }
            }
        },
        {
            Text = "6 Year Anniversary Code - 6YEARS",
            Indent = {
                {
                    Text = "2x EXP and a Lucky Arrow, thank you all for playing!"
                },
                {
                    Text = "(Prestige 1 Requirement to redeem, expires in 1 week)"
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- The Gang Name filter which previously broke due to a ROBLOX update has been fixed."
                },
                {
                    Text = "- Patched random hole in the ocean by The Tallest Peak."
                },
                {
                    Text = "- Fixed True Damage preventing additional damage being dealt to victims with negative Physical Defense."
                },
                {
                    Text = "- Corrected Shed Armor\'s skill tree description."
                },
                {
                    Text = "- Fixed The Greatest High being decreased when receiving healing, including lifesteal."
                },
                {
                    Text = "- Combustible Clones explosion damage is fixed."
                },
                {
                    Text = "- Fixed Tommy Gun Barrage not being able to hit more than two people."
                },
                {
                    Text = "- Fixed Secret Technique passive causing a weird delay when using any abilities."
                }
            }
        },
        {
            Text = "New Stand Skins",
            Indent = {
                {
                    Text = "- Molted Chariot | Uncommon (Chariot Requiem)"
                },
                {
                    Text = "- Made in Pibble | Uncommon (Made in Heaven)"
                },
                {
                    Text = "- Forged by Hell | Common (Made in Heaven)"
                }
            }
        },
        {
            Text = "Balance Changes",
            Indent = {
                {
                    Text = "- Reset all skill trees."
                },
                {
                    Text = "- Madness Sorrow now bypasses counter abilities."
                },
                {
                    Text = "- Dino Full Form detransforming now has end lag."
                },
                {
                    Text = "- Reality Marble fog and duration nerfed."
                },
                {
                    Text = "- Epitaph now has a brief ability restriction at the start of it."
                },
                {
                    Text = "- Epitaph base cooldown increased, however Raging Demon passive does not increase the cooldown anymore."
                },
                {
                    Text = "- All fighting styles received major rebalancing as well as a few stand changes!"
                },
                {
                    Text = "- Join our communications server to see all details from this game version! /sg"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="511">
          <Properties>
            <string name="Name">1.7957</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
