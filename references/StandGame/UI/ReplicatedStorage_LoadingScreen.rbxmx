            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7973",
    Date = 1774368000,
    Notes = {
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Abilities which have special interactions with gang members or people on your ROBLOX friends list are fixed."
                },
                {
                    Text = "- Fixed Charisma\'s counter still being active during missed end lag."
                },
                {
                    Text = "- Void Surprise can no longer movestack."
                },
                {
                    Text = "- Corrected Infinite Void I-V descriptions."
                },
                {
                    Text = "- Detonate Bomb menu spamming has been resolved."
                },
                {
                    Text = "- Turtle Form can no longer be used during Shell Form."
                },
                {
                    Text = "- Tea Time no longer causes a damage animation."
                }
            }
        },
        {
            Text = "Main Balances",
            Indent = {
                {
                    Text = "- Shadow The World, Purple Haze, and Made in Heaven received major changes!"
                },
                {
                    Text = "- Reset all skill trees!"
                },
                {
                    Text = "- Join our communications server to see all details from this game version! /sg"
                }
            }
        }
    }
};]]></string>
