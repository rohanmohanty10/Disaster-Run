        <Item class="ModuleScript" referent="513">
          <Properties>
            <string name="Name">1.7954</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7954",
    Date = 1763744400,
    Notes = {
        {
            Text = "Changes & Bug Fixes",
            Indent = {
                {
                    Text = "- Temporarily disabled the following abilities while we fix a major bug with them: Erase Time, Dimension Hop, Dimensional Dip"
                },
                {
                    Text = "- Minimum Rank Points won/loss per ranked 1v1s match decreased to 15."
                },
                {
                    Text = "- Ranked 1v1s Elo Difference Multiplier decreased."
                },
                {
                    Text = "- Stand Jump no longer ragdolls people within Erased Time, Cream\'s void, etc."
                },
                {
                    Text = "- Corrected Fused Zamasu\'s aura."
                }
            }
        },
        {
            Text = "Balance Changes & Dev Note",
            Indent = {
                {
                    Text = "- Reset all skill trees."
                },
                {
                    Text = "- Stand Barrage damage is no longer increased by Destructive Power skill tree upgrades."
                },
                {
                    Text = "- Globally rebalanced all Stand Barrage damage."
                },
                {
                    Text = "- Most fighting styles have had their passive damage and defense buffs nerfed."
                },
                {
                    Text = "- Join our communications server to see the rest of the balance changes from this game version! /sg"
                },
                {
                    Text = "- There are less than 2 weeks before the event ends! Use the code \"HALLOWEEN2025\" before it expires on December 1st!"
                }
            }
        }
    }
};]]></string>
