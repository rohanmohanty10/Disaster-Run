            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.77",
    Date = 1736960400,
    Notes = {
        {
            Text = "🎄 2024 Christmas Event Ended 🌷",
            Indent = {
                {
                    Text = "- Christmas Decor removed and Christmas Presents are no longer obtainable."
                },
                {
                    Text = "- Disabled 2x Item Spawns and Stand Skin Chances."
                },
                {
                    Text = "🎉 Thank you all for participating and Happy New Years! 🎊"
                }
            }
        },
        {
            Text = "NEW Stand Skins!",
            Indent = {
                {
                    Text = "> Thanos - The Hand (Legendary)"
                },
                {
                    Text = "> Warhammer Titan - White Album (Legendary)"
                },
                {
                    Text = "> Neco Arc - D4C Love Train (Legendary)"
                },
                {
                    Text = "> Goku Black - King Crimson Requiem (Epic)"
                },
                {
                    Text = "> Sailor S&W - Soft & Wet: Go Beyond (Uncommon)"
                },
                {
                    Text = "> Triangle Guard - D4C (Uncommon)"
                }
            }
        },
        {
            Text = "NEW CODE - 12 HOURS WITHOUT SG",
            Indent = {
                {
                    Text = "- Gives a Lucky Arrow!"
                },
                {
                    Text = "- Requires Prestige 1."
                },
                {
                    Text = "- Expires in 3 days, sorry about the wait!"
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Stand Skin Shop changed to randomly rotate between all stands until every single one appears, allowing every stand the guarantee of appearing in the shop!"
                },
                {
                    Text = "- Soft & Wet: Go Beyond added to the Stand Skin Shop rotation."
                },
                {
                    Text = "- Lowered overall game volume and fixed any inconsistent volume levels."
                },
                {
                    Text = "- Edited/Added auras and trails to some stand skins."
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Roll Stand not working when purchased."
                },
                {
                    Text = "- Soft & Wet: Go Beyond skins being unattainable."
                },
                {
                    Text = "- Ground Breaker Bulb Punch creating an invisible hitbox."
                },
                {
                    Text = "- Changed some particles on certain clouds/gasses (very minor change)."
                },
                {
                    Text = "- Fugo Ladder fixed. (for like the millionth time)"
                }
            }
        },
        {
            Text = "v1.77 Balance List",
            Indent = {
                {
                    Text = "The balance list for this update was too massive to fit here, please check the communication server\'s #updates channel to see the whole list if you\'re interested!"
                }
            }
        }
    }
};]]></string>
