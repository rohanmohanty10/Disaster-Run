            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.59",
    Date = 1727481513,
    Notes = {
        {
            Text = "3 New Fighting-Styles",
            Indent = {
                {
                    Text = "- Hamon (Joseph Joestar)"
                },
                {
                    Text = "- Hamon (Caesar Zeppeli)"
                },
                {
                    Text = "- Hamon (William Zeppeli)"
                }
            }
        },
        {
            Text = "NEW CODE:",
            Indent = {
                {
                    Text = "- YOUR NEXT LINE IS",
                    Indent = {
                        {
                            Text = "> Gives a Lucky Arrow and 1 out of the 3 new Fighting-Style Items"
                        },
                        {
                            Text = "> Expires in 3 Days"
                        }
                    }
                }
            }
        },
        {
            Text = "New Hamon Trainer - Lisa Lisa",
            Indent = {
                {
                    Text = "- Two new Fighting-Style obtainment items:",
                    Indent = {
                        {
                            Text = "> Zeppeli’s Hat"
                        },
                        {
                            Text = "> Clackers"
                        }
                    }
                },
                {
                    Text = "- Talk to the NEW Lisa Lisa NPC near the fountain outside of the Arcade to learn ALL Hamon fighting-styles"
                },
                {
                    Text = "- Hamon (Jonathan Joestar) can now be obtained by giving an Ancient Scroll to Lisa Lisa"
                },
                {
                    Text = "- Zeppeli’s Headband item renamed to Caesar’s Headband, used to obtain Hamon (Caesar Zeppeli)"
                }
            }
        },
        {
            Text = "All Fighting-Style Reworked",
            Indent = {
                {
                    Text = "- Boxing, Sword-Style, Hamon (Jonathan Joestar), Vampirism, and Spin redesigned!"
                },
                {
                    Text = "- NEW skill trees"
                },
                {
                    Text = "- Rebalanced all fighting-style abilities"
                },
                {
                    Text = "- Blood Bottles are no longer available for purchase"
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Reset all skill trees"
                },
                {
                    Text = "- Added a setting to disable screenshake"
                },
                {
                    Text = "- M1 stun is now a static number"
                },
                {
                    Text = "- Disabled screen capture to avoid accidental usage"
                },
                {
                    Text = "- Disabled layered clothing and avatar bundles to prevent smaller hitboxes and lag"
                },
                {
                    Text = "- Dino Army dust cloud VFX only procs once per use to prevent lag"
                }
            }
        },
        {
            Text = "Balances",
            Indent = {
                {
                    Text = "- M1 combos are no longer true past the first two M1s"
                },
                {
                    Text = "- Dino Minions are unable to attack for a second after spawning"
                },
                {
                    Text = "- Plundering upgrades have a reduced increase to blindness duration for Vision Plunder"
                },
                {
                    Text = "- Plundering upgrades now slightly increase Vision Plunder projectile speed"
                },
                {
                    Text = "- Go Beyond no longer auto tracks victims"
                },
                {
                    Text = "- Go Beyond no longer bypasses invincibility frames"
                },
                {
                    Text = "- Go Beyond hitbox adjusted to only explode on direct hits"
                },
                {
                    Text = "- Go Beyond windup reduced by 50%"
                },
                {
                    Text = "- Go Beyond explosion size increased by 50%"
                },
                {
                    Text = "- Go Beyond projectile speed increased by 50%"
                },
                {
                    Text = "- Bubble Generation cooldown increased by 5 seconds"
                },
                {
                    Text = "- Bubble Generation maximum healing amount decreased from 40 to 30"
                },
                {
                    Text = "- Bubble Generation height & speed when lifting you increased by 50%"
                },
                {
                    Text = "- Fixed using abilities while in the Bubble Generation bubble"
                },
                {
                    Text = "- White Album’s stand barrage range increased to that of a humanoid stand"
                },
                {
                    Text = "- Ice Sweeps windup increased by 0.2 seconds"
                },
                {
                    Text = "- Ice Sweeps damage reduced from 15 to 12 per sweep"
                },
                {
                    Text = "- Flash Freeze, Ice Punch, and Ice Swipe damages slightly reduced"
                },
                {
                    Text = "- Flash Freeze windup increased by 0.3 seconds"
                },
                {
                    Text = "- Ice Swipe victims are now ragdolled when hit while frozen"
                },
                {
                    Text = "- Self Distribution healing amount decreased by 40%"
                },
                {
                    Text = "- Summon Life Form now has a windup and is cancelable"
                },
                {
                    Text = "- Life Beam of Creation now has a windup and is cancelable"
                },
                {
                    Text = "- Summon Tree now has 0.5 seconds of end lag"
                },
                {
                    Text = "- Return to Zero now has 0.5 seconds of end lag"
                },
                {
                    Text = "- Gold Experience Requiem’s awakening no longer heals or increases jump height"
                },
                {
                    Text = "- Life Beam of Creation cooldown increased to 18 seconds"
                },
                {
                    Text = "- Nullification: Zero cooldown reduced to 30 seconds"
                },
                {
                    Text = "- The World Over Heaven can now receive the damage bonus from Hamon Punch upgrades again"
                },
                {
                    Text = "- Silver Chariot & Anubis are no longer buffed by Lethal Tempo"
                },
                {
                    Text = "- Silver Chariot & Anubis no longer gain Lethal Tempo stacks from their abilities"
                }
            }
        },
        {
            Text = "Fixes",
            Indent = {
                {
                    Text = "- EU West servers in 1v1s gamemode"
                },
                {
                    Text = "- The first person to join a 1v1s queue server not loading properly"
                },
                {
                    Text = "- 2v2s win screen being infinite if their partner leaves the game early"
                },
                {
                    Text = "- M1 Combos not always registering punches"
                },
                {
                    Text = "- Using Stone Masks in game modes"
                },
                {
                    Text = "- Losing items when they’re held while using a Stone Mask"
                },
                {
                    Text = "- Blessing of Sparks flinging bug"
                },
                {
                    Text = "- Blessing of Sparks scaling off of Destructive Power skill tree upgrades"
                },
                {
                    Text = "- Anti-cheat kicking people who die during Universe Reset"
                },
                {
                    Text = "- Finisher inventory not showing all finishers if you own a lot"
                },
                {
                    Text = "- Certain spots in SBR where you could teleport out of the map"
                },
                {
                    Text = "- Text becoming invisible when pressing continue early on long dialogue"
                },
                {
                    Text = "- Giorno finally put on some pants"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="527">
          <Properties>
            <string name="Name">1.57</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.57",
    Date = 1722062693,
    Notes = {
        {
            Text = "Steel Ball Run REWORKED",
            Indent = {
                {
                    Text = "- NEW Map!",
                    Indent = {
                        {
                            Text = "> 5 NEW Stages"
                        },
                        {
                            Text = "> New Starting-line map and Finish-line map"
                        },
                        {
                            Text = "> Random Stage Generation; every match is a randomized order and set of stages"
                        }
                    }
                },
                {
                    Text = "- NEW Blessings (power-ups)!",
                    Indent = {
                        {
                            Text = "> As you race you can choose from a selection of 3 random Blessings to power up your build; there are 20+ Blessings so far, encouraging unique builds per game!"
                        },
                        {
                            Text = "> Every time you enter a new stage it has a chance of prompting the 3 random Blessings on your screen!"
                        },
                        {
                            Text = "> The first person to reach a stage will be granted +1 Blessing REROLL"
                        },
                        {
                            Text = "> Blessing Example #1: Firebrand - power up all your Fire🔥-related damage"
                        },
                        {
                            Text = "> Blessing Example #2: Bloodthirster - heal for every Sword⚔️-related damage dealt"
                        }
                    }
                },
                {
                    Text = "- NEW Death Screen",
                    Indent = {
                        {
                            Text = "> Spectate other players with free camera movement"
                        },
                        {
                            Text = "> View your Match’s stats and rewards"
                        },
                        {
                            Text = "> Quickly join other SBR matches or Return to the Main Game"
                        }
                    }
                },
                {
                    Text = "- Other",
                    Indent = {
                        {
                            Text = "> Fixed the Revolver’s trajectory being offset"
                        },
                        {
                            Text = "> And more in-game!"
                        }
                    }
                }
            }
        },
        {
            Text = "1v1 Ranked RELEASE",
            Indent = {
                {
                    Text = "- Seasons",
                    Indent = {
                        {
                            Text = "> Ranks reset every 4 months: January, May, September"
                        },
                        {
                            Text = "> May 2024 is Season 1, September 2024 is Season 2, January 2025 is season 3, etc"
                        }
                    }
                },
                {
                    Text = "- Rank Divisions & Tiers",
                    Indent = {
                        {
                            Text = "> There are 9 Rank Divisions; Iron, Bronze, Silver, Gold, Platinum, Diamond, Crusader, Requiem, and Ascended"
                        },
                        {
                            Text = "> Each rank has 4 tiers in-between; for example Iron I, Iron II, Iron III, and Iron IV"
                        }
                    }
                },
                {
                    Text = "- Rank Points [RP]",
                    Indent = {
                        {
                            Text = "> Going above 100 RP will promote your rank by 1 tier"
                        },
                        {
                            Text = "> Going below 0 RP will demote your rank by 1 tier"
                        },
                        {
                            Text = "> Example #1: Iron III promotes to Iron IV"
                        },
                        {
                            Text = "> Example #2: Iron IV promotes to Bronze I"
                        }
                    }
                },
                {
                    Text = "- Top 100 Ascended Global Leaderboard",
                    Indent = {
                        {
                            Text = "> Ascended is the final rank meaning you can no longer promote, so instead you can gain infinite RP"
                        },
                        {
                            Text = "> For example Paragon is Ascended 20 RP and Uzu is Ascended 991 RP so Uzu will be known as Rank 1 in the Top 100s for having the highest Ascended RP"
                        }
                    }
                },
                {
                    Text = "- Placements",
                    Indent = {
                        {
                            Text = "> You start with a Placement Rank every Season, this is called Placements"
                        },
                        {
                            Text = "> You can\'t lose RP in Placements but you do win more than normal"
                        },
                        {
                            Text = "> Win 5 games to receive a Real Rank which is the Placement Rank that you ended with"
                        },
                        {
                            Text = "> Your starting Placement Rank is Iron I. However if you ended a previous season with a Rank then you will instead start with it minus 1 division"
                        }
                    }
                },
                {
                    Text = "- MMR (Matchmaking Rating)",
                    Indent = {
                        {
                            Text = "> MMR is a calculation for deciding how much RP you lose/gain depending on who you fight and will also decide who you can fight"
                        },
                        {
                            Text = "> You won’t fight anyone that is 2 divisions under or above you, and you are more likely to fight someone closer to your MMR"
                        },
                        {
                            Text = "> Example #1: You beat someone whose higher rank, you gain bonus RP"
                        },
                        {
                            Text = "> Example #2: You beat someone whose higher win-rate, you gain bonus RP"
                        },
                        {
                            Text = "> Example #3: The opposite applies for when losing RP; you lose to someone whose higher rank, you lose less RP"
                        }
                    }
                },
                {
                    Text = "- Loot",
                    Indent = {
                        {
                            Text = "> Every 20 L.P. (Loot Points) will grant you a random Loot"
                        },
                        {
                            Text = "> Gain +4 L.P. from Unranked wins; Ranked wins are +8"
                        },
                        {
                            Text = "> The chances to gain more rare loot are increased with your Rank"
                        }
                    }
                },
                {
                    Text = "- Other",
                    Indent = {
                        {
                            Text = "> View your 10 most recent match histories"
                        },
                        {
                            Text = "> View your wins/losses and winrate"
                        },
                        {
                            Text = "> View the highest rank you\'ve ever reached across Seasons"
                        },
                        {
                            Text = "> View your builds’ win-rates (specific stands, specs, etc)"
                        },
                        {
                            Text = "> Promotion animations!"
                        },
                        {
                            Text = "> New match timer of 20 minutes; when the timer reaches 0, it will count as a loss for both players"
                        },
                        {
                            Text = "> New post-lobby map and stats"
                        },
                        {
                            Text = "> And more in-game!"
                        }
                    }
                }
            }
        },
        {
            Text = "Finishers [NEW]",
            Indent = {
                {
                    Text = "- Finishers are special effects that are played on Players and Mobs that you finish off!"
                },
                {
                    Text = "- They can be obtained from specific 1v1s Loot or bought in the HUD Shop which is also where they can be equipped"
                },
                {
                    Text = "- 20 Finishers obtainable in-game!"
                }
            }
        },
        {
            Text = "Premium Benefits [NEW]",
            Indent = {
                {
                    Text = "- Free Daily Login Rewards",
                    Indent = {
                        {
                            Text = "> Login the game every day and press the Daily Login button at the bottom to receive a Premium-only free reward!"
                        },
                        {
                            Text = "> Reward: Random 1v1s Loot"
                        }
                    }
                },
                {
                    Text = "- Stand Skins",
                    Indent = {
                        {
                            Text = "> 25% increased Stand Skin chances!"
                        }
                    }
                },
                {
                    Text = "- ROBLOX Benefits",
                    Indent = {
                        {
                            Text = "> All of ROBLOX\'s Premium benefits are listed on ROBLOX\'s Premium Page!"
                        }
                    }
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Added critical strikes",
                    Indent = {
                        {
                            Text = "> Stats are shown in the Character frame"
                        },
                        {
                            Text = "> A critical strike is a damage event that deals 150% of its normal damage by default, denoted as critical strike damage"
                        },
                        {
                            Text = "> The default critical strike chance is 10%"
                        },
                        {
                            Text = "> By default, only your Basic-Attacks (M1/M2) can critically strike"
                        }
                    }
                },
                {
                    Text = "- Added Patch-Notes-Log Ingame",
                    Indent = {
                        {
                            Text = "> You can now see a Log of Patch Notes in the play-screen in-game; It’s basically an update log"
                        },
                        {
                            Text = "> Hi"
                        }
                    }
                },
                {
                    Text = "- Added automatic Basic Attacks for M1s aka holding down M1s"
                },
                {
                    Text = "- Fixed the bug where the game loads for a long time or doesn’t even load properly when you are the first person to join a fresh new server"
                },
                {
                    Text = "- Unlocking skill tree nodes that increase your Max HP will now update your Max HP without needing to reset your Character"
                }
            }
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="528">
          <Properties>
            <string name="Name">1.7962</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7962",
    Date = 1770051600,
    Notes = {
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Universe Reset upgrade is temporarily disabled because of a major bug due to a recent ROBLOX update."
                },
                {
                    Text = "- Changed the Fugo Boss & Uzurashi NPC location into a park."
                },
                {
                    Text = "- Moved DIO Quest NPC and Part 3 Jotaro Boss."
                },
                {
                    Text = "- Ult Ragdoll Cooldown renamed to Ultimate Ability Cooldown."
                },
                {
                    Text = "- Bites The Dust, Heavy Weather, and Go Beyond now count as an Ultimate Abilities."
                },
                {
                    Text = "- All Skill Trees reset."
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Fixed a silent ROBLOX error that caused Void Surprise not to work for certain players."
                },
                {
                    Text = "- God of Death no longer affects non-stand M1s."
                },
                {
                    Text = "- Superhuman Strength III now heals the user while they\'re being barraged."
                },
                {
                    Text = "- Fixed Hamon & Spin bar UI display bugs."
                },
                {
                    Text = "- Fixed Essence of Flamberge on Unsealed Steel."
                },
                {
                    Text = "- Metal Silver Overdrive and Zoom punch no longer apply their missed/blocked end lag, despite successfully hitting opponents."
                },
                {
                    Text = "- Molted Chariot skin\'s arrow stab positioning is now canon"
                },
                {
                    Text = "- Joe\'s Pride aura now properly displays."
                }
            }
        },
        {
            Text = "Balances can be found in our communications server. /sg"
        }
    }
};]]></string>
            <int64 name="SourceAssetId">-1</int64>
