        <Item class="ModuleScript" referent="529">
          <Properties>
            <string name="Name">1.797</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.797",
    Date = 1771606800,
    Notes = {
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Universe Reset is re-enabled and can be unlocked in Made in Heaven\'s skill tree again."
                },
                {
                    Text = "- Reduced false anti-cheat kicks."
                },
                {
                    Text = "- The NYC Bridge stage disabled abilities warning has been changed to describe all abilities that would be unfair to use during the final stage."
                },
                {
                    Text = "- Instant resetting no longer occurs outside of Main Game."
                }
            }
        },
        {
            Text = "NEW Stand Skins",
            Indent = {
                {
                    Text = "> Mr. Tentacles | Legendary (Hierophant Green)"
                },
                {
                    Text = "> Muffet | Epic (Hierophant Green)"
                },
                {
                    Text = "> Soft & Starry | Uncommon (Soft & Wet)"
                }
            }
        },
        {
            Text = "Balances",
            Indent = {
                {
                    Text = "- Killer Queen, Killer Queen: Bites The Dust, and Stone Free received major changes and new SFX/voicelines!"
                },
                {
                    Text = "- Reset all skill trees!"
                },
                {
                    Text = "- Join our communications server to see all details from this game version! /sg"
                }
            }
        }
    }
};]]></string>
