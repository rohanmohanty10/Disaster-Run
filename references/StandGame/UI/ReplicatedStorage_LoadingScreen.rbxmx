        <Item class="ModuleScript" referent="523">
          <Properties>
            <string name="Name">1.7</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7",
    Date = 1732899600,
    Notes = {
        {
            Text = "2024 Halloween Event",
            Indent = {
                {
                    Text = "- Event extended, will end on December 8th."
                }
            }
        },
        {
            Text = "NEW Stand - Weather Report",
            Indent = {
                {
                    Text = "- Defeat Jotaro Part 6 for a 5% chance to obtain Weather Report\'s Stand Disc!"
                }
            }
        },
        {
            Text = "NEW Stand - Chili Pepper Alternate Universe",
            Indent = {
                {
                    Text = "- Use a Heart of the Saint’s Corpse while using Red Hot Chili Pepper to evolve and obtain this new stand!"
                }
            }
        },
        {
            Text = "Weather Report Stand Skins",
            Indent = {
                {
                    Text = "- Korra (Legendary)"
                },
                {
                    Text = "- Zeus (GOW) (Legendary)"
                },
                {
                    Text = "- Reporter (Epic)"
                },
                {
                    Text = "- Zeus (OP) (Epic)"
                },
                {
                    Text = "- Weathersnake (Uncommon)"
                },
                {
                    Text = "- Stormy (Uncommon)"
                },
                {
                    Text = "- Anime WR (Common)"
                },
                {
                    Text = "- Manga WR (Common)"
                }
            }
        },
        {
            Text = "Chili Pepper Stand Skins",
            Indent = {
                {
                    Text = "- Killua (Legendary)"
                },
                {
                    Text = "- Zenitsu (Legendary)"
                },
                {
                    Text = "- Devil Pepper (Common)"
                },
                {
                    Text = "- The Plague Doctor (Common)"
                }
            }
        },
        {
            Text = "Changes",
            Indent = {
                {
                    Text = "- Lucky Arrows and Stand Shop purchases now roll stands given from the Ribcage of the Saint\'s Corpse item."
                },
                {
                    Text = "- All players who deal more than 30% of a NPC/Mob Max HP get the rewards for defeating it. (Quest Progress, EXP, Money, Drops, etc)"
                },
                {
                    Text = "- Press/Hold space while using a Teleporting Dash will now teleport you upwards."
                },
                {
                    Text = "- [Red Hot Chili Pepper] You can now charge Stand and Fighting-Style bars at the same time."
                },
                {
                    Text = "- Doubled Evolved Stand Chest gem cost."
                },
                {
                    Text = "- Certain countries previously banned from SG due to gambling can now play SG. (In-game purchase restrictions.)"
                }
            }
        },
        {
            Text = "Bug Fixes",
            Indent = {
                {
                    Text = "- Gamepass tools overlapping your Hotbar Saves when respawning."
                },
                {
                    Text = "- Stand Disc ability not disabling Mobs’ stands."
                },
                {
                    Text = "- Zipper Pole one shot."
                },
                {
                    Text = "- Shadow The World Time Stop VFX becoming permanent."
                },
                {
                    Text = "- Bakugo victims using abilities while grabbed."
                }
            }
        },
        {
            Text = "Time Stop Balancing",
            Indent = {
                {
                    Text = "- You can now run in stopped time."
                },
                {
                    Text = "- Global Time Stop cooldown reduced to 8 seconds."
                },
                {
                    Text = "- Time Stop range reduced by -35%."
                },
                {
                    Text = "- Reduced Time Stop damage cap to 1/3 of victim max HP. (Previously 37.5%)"
                },
                {
                    Text = "- Reduced Time Stop “resume” duration, making stopped time end faster."
                },
                {
                    Text = "- All Time Stop ability and upgrade skill point costs adjusted."
                },
                {
                    Text = "- Time Stop windup duration adjusted to match animations better."
                },
                {
                    Text = "- Shadow The World\'s Time Stop windup increased."
                },
                {
                    Text = "- Shadow The World’s Time Stop cooldown increased."
                },
                {
                    Text = "- Base Time Stop and TS Movement durations reduced/adjusted on all Stands with it."
                },
                {
                    Text = "- Time Stop Mastery upgrades now add exactly 1 second to stopped time and 0.5 seconds to TS Movement."
                },
                {
                    Text = "- Infinite Rotation Mastery’s TS Movement upgrade buffed accordingly."
                }
            }
        },
        {
            Text = "General Balancing",
            Indent = {
                {
                    Text = "- Corrected animations for many abilities which may have been out of sync with their windup time."
                },
                {
                    Text = "- Red Hot Chili Pepper electric charge passive requirement raised."
                },
                {
                    Text = "- Red Hot Chili Pepper passive electric charge rate increased."
                },
                {
                    Text = "- Red Hot Chili Pepper skill tree costs are reduced."
                },
                {
                    Text = "- Electric Guitar charging rate and Guitarist upgrades buffed."
                },
                {
                    Text = "- Pinky Slash stun reduced."
                },
                {
                    Text = "- Stand Barrage and “Barrage-type” ability knockback reduced."
                },
                {
                    Text = "- Stand Combo rebalanced; end lag, windup, knockback, etc."
                },
                {
                    Text = "- Punishment cooldown increased."
                },
                {
                    Text = "- Punishment damage reduced."
                },
                {
                    Text = "- Impale III damage buff reduced."
                },
                {
                    Text = "- Time Switch now forces the victim to face the opposite direction of the user."
                },
                {
                    Text = "- The World Alternate Universe skill tree costs are reduced."
                },
                {
                    Text = "- Rod Slap windup adjusted to fit animation."
                },
                {
                    Text = "- Rod Slap hitbox range increased but width decreased."
                },
                {
                    Text = "- Rod Slap hitbox duration reduced."
                },
                {
                    Text = "- Liver Shot hitbox size increased."
                },
                {
                    Text = "- Jawbreaker hitbox size slightly reduced."
                },
                {
                    Text = "- Reduced Superhuman Barrage and Sunlight Yellow Overdrive ragdoll time."
                },
                {
                    Text = "- Added a Time Stop cooldown to Superhuman Barrage and Sunlight Yellow Overdrive final hits."
                },
                {
                    Text = "- Superhuman Barrage hitbox size adjusted."
                },
                {
                    Text = "- Hamon Punch IV & V upgrades increase damage by 5%, the same as I-III."
                },
                {
                    Text = "- Zoom Punch hitbox is now very narrow but slightly longer."
                },
                {
                    Text = "- Zoom Punch hitbox duration reduced."
                },
                {
                    Text = "- Tornado Overdrive hitbox size increased."
                },
                {
                    Text = "- Joestar Resolve I & II upgrades buffed."
                },
                {
                    Text = "- Superhuman Barrage hitbox size adjusted."
                },
                {
                    Text = "- Superhuman Barrage hitbox size adjusted."
                },
                {
                    Text = "- Metal Silver Overdrive hitbox size slightly adjusted."
                },
                {
                    Text = "- Scarlet Overdrive hitbox narrowed."
                },
                {
                    Text = "- Sunlight Yellow Overdrive hitbox size adjusted."
                },
                {
                    Text = "- Merged Deep Pass Bubble into the Bubble Lenses upgrade."
                },
                {
                    Text = "- Hamon (Caesar Zeppeli) skill point costs reduced."
                },
                {
                    Text = "- Hamon (Joseph Joestar) skill point costs reduced."
                },
                {
                    Text = "- Hamon (William Zeppeli) skill point costs reduced."
                },
                {
                    Text = "- Twisting Spin Punch hitbox reduced."
                },
                {
                    Text = "- All Spin projectile speeds greatly increased."
                },
                {
                    Text = "- All Spin projectile durations greatly decreased."
                }
            }
        }
    }
};]]></string>
