            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.6",
    Date = 1731672000,
    Notes = {
        {
            Text = "2024 Halloween Event",
            Indent = {
                {
                    Text = "- Event will end on December 1st."
                }
            }
        },
        {
