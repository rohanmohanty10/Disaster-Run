        <Item class="ModuleScript" referent="515">
          <Properties>
            <string name="Name">1.7951</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[ 

 

return {
    Version = "1.7951",
    Date = 1761926400,
    Notes = {
        {
            Text = "NEW Stand Rehaul - Aerosmith",
            Indent = {
                {
                    Text = "- Aerosmith’s abilities and skill tree have been redesigned and rebalanced!"
                },
                {
                    Text = "- 3 NEW Abilities"
                },
                {
                    Text = "- Vola Barrage now gives anti-teaming invincibility to victims and is usable during stun!"
                }
            }
        },
        {
            Text = "QOL and Bug Fixes",
            Indent = {
                {
                    Text = "- Buffed Merchant item selling prices."
                },
                {
                    Text = "- Fixed Vola Barrage hitbox going behind the user."
                },
                {
                    Text = "- Re-added missing Your Own Shadow VFX."
                },
                {
                    Text = "- Fixed Whitesnake\'s erratic movements when using Burst Fire."
                },
                {
                    Text = "- Fixed Dino Army spawn position."
                },
                {
                    Text = "- Fixed Moisture Plunder softlocking the user when used immediately after summoning their stand."
                },
                {
                    Text = "- Explosions no longer prevent projectiles from passing through."
                },
                {
                    Text = "- Removed many item collisions that messed with physics and movement."
                },
                {
                    Text = "- Fixed Kars\' quest to defeat 2 Hamon users."
                },
                {
                    Text = "- Fixed and improved Neco Arc\'s aura..."
                }
            }
        },
        {
            Text = "Balance Changes & Developer Note",
            Indent = {
                {
                    Text = "- The following stands received changes this update: Star Platinum, Six Pistols, Sticky Fingers, Purple Haze, Mr. President, White Album, Chariot Requiem, Whitesnake, Weather Report, and C-Moon!"
                },
                {
                    Text = "- Join our communications server to see many more details on balances from this game version! /sg"
                },
                {
                    Text = "- Happy Halloween everyone! We hope you are enjoying the weekly updates and Halloween event! Reminder to use the code \"HALLOWEEN2025\" before it expires on December 1st!"
                }
            }
        }
    }
};]]></string>
