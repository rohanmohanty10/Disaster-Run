                {
                    Text = "- Space Ripper Stingy Eyes speed and windup time increased."
                },
                {
                    Text = "- Superhuman Barrage windup time increased."
                },
                {
                    Text = "- Luck & Pluck hitbox size increased."
                },
                {
                    Text = "- Scarlet Overdrive hitbox size increased."
                },
                {
