-- Display order inside each rarity (dictionary order isn't stable).
Kits.Order = {
	God = { "Rockfall", "GalePalm", "EmberSpark", "FrostWarden", "Tidecaller", "FireFist", "SandCalamity", "ShadowWeaver", "MagmaAdmiral", "ThunderGod", "GravityLord", "LightAdmiral", "WorldShaker", "BlackFlame", "KingOfCurses" },
	Runner = { "QuickFeet", "SecondWind", "Bounce", "FlashStep", "Moonwalk", "DiveRoll", "Shinobi", "Brawler", "ClapSwapper", "InstantTransmission", "Godspeed", "WindWalker", "UltraInstinct", "Metavision", "HonoredOne", "TimeLord" },
}

function Kits.IsRole(role: any): boolean
	return role == "God" or role == "Runner"
end

function Kits.Get(role: Role, kitId: string): Kit?
	local list = (Kits :: any)[role]
	return if list then list[kitId] else nil
end

-- Kit ids of one rarity, in display order.
function Kits.ByRarity(role: Role, rarity: string): { string }
	local result = {}
	for _, kitId in (Kits.Order :: any)[role] do
		local kit = (Kits :: any)[role][kitId]
		if kit.Rarity == rarity then
			table.insert(result, kitId)
		end
	end
	return result
end

return Kits
