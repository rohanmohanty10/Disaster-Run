--!strict
-- Kit catalog for both vaults. Mirrors ABILITIES.md: keep the two in sync.
-- Format follows the vault screen: Name + Rarity + a one-line flavour Desc, plus mechanical skill data.
-- Damage is a number, or a string for multi-hit / scaling skills (display only until abilities are built).

export type Skill = {
	Name: string,
	Key: string,
	Shape: string,
	Desc: string,
	Damage: number | string,
	Cooldown: number,
	Cost: number,
	Ultimate: boolean,
}

export type Kit = {
	Id: string,
	Name: string,
	Rarity: string,
	Element: string,
	Desc: string,
	Skills: { Skill },
	Passive: { Name: string, Desc: string }?,
}

export type Role = "God" | "Runner"

